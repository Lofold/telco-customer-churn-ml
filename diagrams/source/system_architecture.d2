# Logical architecture of the local project.
direction: right

analyst: "Специалист по данным\n/ ML-разработчик" {
  shape: person
  style.fill: "#526579"
  style.font-color: "#FFFFFF"
  style.stroke: "#34495E"
}

git: "Git / GitHub" {
  style.fill: "#E8EDF2"
  style.stroke: "#8493A2"
  style.font-color: "#263746"
}

runtime: "Локальное окружение Python" {
  direction: down
  style.fill: "#F5F8FB"
  style.stroke: "#AFC3D3"
  style.stroke-width: 2

  row1: "" {
    direction: right
    split: "scripts/split_data.py\nПодготовка initial/incoming\n[реализовано]" {
      style.fill: "#E6F2E9"; style.stroke: "#4C8A5B"
    }
    eda: "scripts/eda_initial.py\nEDA и отчёты\n[реализовано]" {
      style.fill: "#E6F2E9"; style.stroke: "#4C8A5B"
    }
  }

  row2: "" {
    direction: right
    validator: "Модуль валидации пакетов\n[планируется]" {
      style.fill: "#FFF2D8"; style.stroke: "#B8892E"
    }
    trainer: "Обучение и оценка модели\n[планируется]" {
      style.fill: "#FFF2D8"; style.stroke: "#B8892E"
    }
    predictor: "Пакетное прогнозирование\n[планируется]" {
      style.fill: "#FFF2D8"; style.stroke: "#B8892E"
    }
  }
}

storage: "Данные и Артефакты" {
  direction: down

  sources: "Хранилище данных" {
    direction: right
    style.fill: "#F6F3FA"; style.stroke: "#C5B8D9"; style.stroke-width: 2
    raw: "data/raw/\nЭталонный CSV" { shape: cylinder; style.fill: "#E8EDF2"; style.stroke: "#8493A2" }
    initial: "data/initial/\ninitial_60.csv" { shape: cylinder; style.fill: "#EAF2F8"; style.stroke: "#315A7D" }
    incoming: "data/incoming/\nbatch_01…04.csv" { shape: cylinder; style.fill: "#E8EDF2"; style.stroke: "#8493A2" }
  }

  artifacts: "Отчёты и ML-артефакты" {
    direction: right
    style.fill: "#F7F4FA"; style.stroke: "#C5B8D9"; style.stroke-width: 2
    manifest: "reports/data_manifest.csv\n[реализовано]" { shape: document; style.fill: "#E6F2E9"; style.stroke: "#4C8A5B" }
    eda_reports: "reports/eda/\n[реализовано]" { shape: package; style.fill: "#E6F2E9"; style.stroke: "#4C8A5B" }
    model: "models/\nобученная модель\n[планируется]" { shape: cylinder; style.fill: "#E9E1F8"; style.stroke: "#8265A5" }
  }
}

# Связи
analyst -> runtime.row1.split: "запускает"
analyst -> runtime.row1.eda: "запускает"
analyst -> runtime.row2.validator: "будущий сценарий"
analyst -> runtime.row2.trainer: "будущий сценарий"
analyst -> runtime.row2.predictor: "будущий сценарий"
analyst -> git: "контроль версий"

runtime.row1.split -> storage.sources.raw: "читает"
runtime.row1.split -> storage.sources.initial: "создаёт"
runtime.row1.split -> storage.sources.incoming: "создаёт"
runtime.row1.split -> storage.artifacts.manifest: "записывает"

runtime.row1.eda -> storage.sources.initial: "анализирует"
runtime.row1.eda -> storage.artifacts.eda_reports: "формирует"

runtime.row2.validator -> storage.sources.incoming: "проверяет"
runtime.row2.trainer -> storage.sources.initial: "использует"
runtime.row2.trainer -> storage.artifacts.model: "сохраняет"
runtime.row2.predictor -> storage.sources.incoming: "обрабатывает"
runtime.row2.predictor -> storage.artifacts.model: "загружает"

note: "Git/GitHub — инструменты разработки, а не контейнеры выполняемой ML-системы." {
  shape: callout
  style.fill: "#F4F6F8"; style.stroke: "#AAB6C0"
}
git -> note: "роль"
