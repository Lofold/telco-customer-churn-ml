@startuml use_case
left to right direction
skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #496779
skinparam ArrowThickness 2
skinparam ActorBorderColor #526579
skinparam UsecaseBorderColor #315A7D

actor "Специалист по данным\n/ ML-разработчик" as Analyst

rectangle "Система анализа и прогнозирования оттока клиентов" {
  package "Планируется" {
    usecase "Оценить прогнозы после\nпоступления фактических меток" as UC_Delayed #FFF2D8
    usecase "Выполнить пакетное\nпрогнозирование" as UC_Predict #FFF2D8
    usecase "Проверить входящий пакет\nпо схеме и качеству" as UC_Validate #FFF2D8
    usecase "Оценить модель на Validation\nи независимом Test" as UC_Evaluate #FFF2D8
    usecase "Сформировать и обучить\nконвейер признаков и модель" as UC_Train #FFF2D8
  }
  package "Реализовано в проекте" {
    usecase "Подготовить начальную выборку\nи incoming-пакеты" as UC_Split #E6F2E9
    usecase "Провести EDA\nи проверки начальной выборки" as UC_EDA #E6F2E9
    usecase "Изучить манифест, отчёты\nи графики" as UC_Reports #E6F2E9
  }
}

Analyst --> UC_Delayed
Analyst --> UC_Predict
Analyst --> UC_Validate
Analyst --> UC_Evaluate
Analyst --> UC_Train
Analyst --> UC_Split
Analyst --> UC_EDA
Analyst --> UC_Reports

UC_Delayed .> UC_Predict : <<extend>>
UC_Predict .> UC_Validate : <<include>>
UC_Train .> UC_Evaluate : <<include>>

legend bottom
  <b>Легенда:</b>
  <color:#4C8A5B>■</color> Реализовано в текущем проекте
  <color:#B8892E>■</color> Планируемые функции
endlegend
@enduml
