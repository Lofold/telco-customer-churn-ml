        </mxCell>
        <mxCell id="t11" value="Итоговая независимая оценка&lt;br&gt;выбранной модели на Test — один раз" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#315A7D;fontColor=#172B3A;fontFamily=Arial;fontSize=13;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;rounded=1;" vertex="1" parent="1">
