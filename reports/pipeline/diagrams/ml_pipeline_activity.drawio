        </mxCell>
        <mxCell id="p11" value="10. Преобразовать входящий пакет&lt;br&gt;повторный fit не выполнять" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#23756E;fontColor=#172B3A;fontFamily=Arial;fontSize=13;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;rounded=1;" vertex="1" parent="1">
