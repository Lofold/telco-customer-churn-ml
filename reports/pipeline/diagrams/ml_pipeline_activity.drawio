        </mxCell>
        <mxCell id="t12" value="Сохранить модель, pipeline, метрики&lt;br&gt;и конфигурацию эксперимента" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F2E8;strokeColor=#4C8A5B;fontColor=#172B3A;fontFamily=Arial;fontSize=13;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="48" y="1260" width="350" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="p10" value="10. Загрузить сохранённые преобразователи&lt;br&gt;и обученную модель" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#23756E;fontColor=#172B3A;fontFamily=Arial;fontSize=13;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;rounded=1;" vertex="1" parent="1">
